modules = ["nodejs-20", "web", "postgresql-16"]
run = "npm run dev"

[nix]
channel = "stable-25_05"

[deployment]
run = ["sh", "-c", "npm run dev"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 43451
externalPort = 3000

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Run"
author = 46653913
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"

[[workflows.workflow]]
name = "Start Application"
author = 46653913
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pkill -f \"vite|node.*server.cjs\" || true"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev & node server.cjs"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "App"

[[workflows.workflow]]
name = "App"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.cjs & npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
